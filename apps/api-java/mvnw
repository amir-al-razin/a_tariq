# Resolve os specific behavior
case "`uname`" in
  CYGWIN*|MINGW*|MSYS*)
    os_windows=true
    ;;
  *)
    os_windows=false
    ;;
esac

if [ -z "$JAVA_HOME" ]; then
  if $os_windows; then
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH."
    exit 1
  fi
  java_cmd=java
else
  java_cmd="$JAVA_HOME/bin/java"
fi

if [ ! -r "$java_cmd" ] && ! command -v "$java_cmd" >/dev/null 2>&1; then
  echo "Error: JAVA_HOME is not correctly defined or 'java' is not executable."
  exit 1
fi

# We use the Maven wrapper JAR if present, otherwise fallback to basic execution or download
jar_path=".mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$jar_path" ]; then
  mkdir -p .mvn/wrapper
  if command -v curl >/dev/null 2>&1; then
    curl -sSL -o "$jar_path" "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$jar_path" "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  fi
fi

exec "$java_cmd" \
  -Dmaven.multiModuleProjectDirectory="$PWD" \
  -classpath "$jar_path" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
