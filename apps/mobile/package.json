{
  "name": "mobile",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --go --tunnel --android",
    "android:lan": "expo start --go --android",
    "android:dev": "expo start --dev-client --android",
    "ios": "expo start --go --tunnel --ios",
    "ios:lan": "expo start --go --ios",
    "start": "expo start --go --tunnel",
    "start:lan": "expo start --go",
    "start:dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "android:prebuild": "CI=1 expo prebuild -p android",
    "android:apk:local": "CI=1 expo prebuild -p android && cd android && ./gradlew assembleRelease",
    "android:apk:debug:local": "CI=1 expo prebuild -p android && cd android && ./gradlew assembleDebug",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@tariq/shared": "workspace:*",
    "expo": "^57.0.23",
    "expo-font": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.0.8",
    "lottie-react-native": "^7.3.8",
    "moti": "^0.30.0",
    "nativewind": "latest",
    "react": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.18",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "main": "index.js",
  "private": true
}
